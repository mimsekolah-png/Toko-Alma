rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global denial default
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Cash Transactions (Nota Cash & Pelunasan)
    match /cashTransactions/{transactionId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.noNota is string
                    && request.resource.data.namaPelanggan is string
                    && request.resource.data.total is number;
      allow update: if request.resource.data.id is string
                    && request.resource.data.noNota is string;
      allow delete: if true;
    }

    // Piutang
    match /piutang/{piutangId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.nama is string
                    && request.resource.data.nominal is number;
      allow update: if request.resource.data.id is string;
      allow delete: if true;
    }

    // Piutang Payments (Riwayat cicilan / pelunasan)
    match /piutangPayments/{paymentId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.nama is string
                            && request.resource.data.nominal is number;
      allow delete: if true;
    }

    // Titipan
    match /titipan/{titipanId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.nama is string
                    && request.resource.data.nominal is number;
      allow update: if request.resource.data.id is string;
      allow delete: if true;
    }

    // Titipan Payments
    match /titipanPayments/{paymentId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.nama is string
                            && request.resource.data.nominal is number;
      allow delete: if true;
    }

    // Rekapitulasi harian
    match /rekap/{rekapId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.tanggal is string;
      allow delete: if true;
    }

    // Settings (misal modal awal toko)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Draft Kas
    match /kas/{docId} {
      allow read, write: if true;
    }

    // Backups & Snapshots Pemulihan
    match /backups/{backupId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.timestamp is number;
      allow delete: if true;
    }
  }
}
